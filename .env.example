# The Google Sheet this instance reads from. One deployment = one client = one sheet.
# Find it in the sheet's URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
SPREADSHEET_ID=

# Optional: only needed if you renamed the tab in the client's spreadsheet copy.
# TREE_SHEET_NAME=Project Tree

# --- Google service account credentials (pick ONE of the two options below) ---

# Option A (recommended for Coolify): the full service-account JSON key file,
# base64-encoded into a single line.
#   macOS/Linux:  base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# Option B: the two fields pulled out of that JSON individually.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
